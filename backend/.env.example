# Database
DATABASE_URL=postgresql://user:pass@host:5432/apz_db

# Security
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
NODE_ENV=production
PORT=3007

# External Services
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AI Service
PYTHON_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=shared_secret_for_service_auth

# CORS & URLs
FRONTEND_URL=https://alpha-power-zone-apz.vercel.app
CORS_ORIGIN=https://alpha-power-zone-apz.vercel.app,http://localhost:5173
